# ─────────────────────────────────────────────────────────────
# Digital Hostel Management System — environment reference
# Copy server/.env.example  -> server/.env
# Copy client/.env.example  -> client/.env
# This root file only documents every variable in one place.
# ─────────────────────────────────────────────────────────────

# ── SERVER (server/.env) ──
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/digital_hostel
CLIENT_URL=http://localhost:5173
TRUST_PROXY=0

JWT_SECRET=                 # >= 32 random chars
JWT_REFRESH_SECRET=         # >= 32 random chars, different from JWT_SECRET
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

COOKIE_SECURE=false         # true in production (HTTPS)
COOKIE_SAMESITE=lax         # "none" only for cross-site deploys (requires COOKIE_SECURE=true)

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false
BOOKING_HOLD_DAYS=3
# Background jobs (reminders, expiries). Run them on ONE server instance only; set false on the others.
ENABLE_SCHEDULER=true

# Chatbot. "none" = built-in knowledge answers only (free, private). "openai_compatible" also asks any OpenAI-compatible API
# (OpenAI, Azure, OpenRouter, a local server …) to phrase the answer from the same public facts. AI_API_KEY is a secret.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# File uploads. "local" stores images in server/uploads (fine for one server / VPS; ephemeral on Render/Railway free tiers!).
# "cloudinary" stores them in your Cloudinary account (recommended for hosted deployments).
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=5
# Public URL of this API (used to build image links for local storage). Leave empty to derive it from each request.
SERVER_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional in development: emails are printed to the console when EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Digital Hostel <no-reply@example.com>"

# Seed (used only by `npm run seed`)
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=

# ── CLIENT (client/.env) ──
VITE_API_URL=/api/v1
