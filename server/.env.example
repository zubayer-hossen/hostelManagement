NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/digital_hostel
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx) so rate limiting sees real IPs
TRUST_PROXY=0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Refresh-token cookie. Production over HTTPS: COOKIE_SECURE=true.
# Frontend and backend on different sites (e.g. Vercel + Render): COOKIE_SAMESITE=none (needs COOKIE_SECURE=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# When true, users must verify their email before they can log in
REQUIRE_EMAIL_VERIFICATION=false
# Days a PENDING room request keeps its bed reserved before it expires automatically
BOOKING_HOLD_DAYS=3
# Background jobs (reminders, expiries). Run them on ONE server instance only; set false on the others.
ENABLE_SCHEDULER=true

# Chatbot. "none" = built-in knowledge answers only (free, private). "openai_compatible" also asks any OpenAI-compatible API
# (OpenAI, Azure, OpenRouter, a local server …) to phrase the answer from the same public facts. AI_API_KEY is a secret.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# File uploads. "local" stores images in server/uploads (fine for one server / VPS; ephemeral on Render/Railway free tiers!).
# "cloudinary" stores them in your Cloudinary account (recommended for hosted deployments).
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=5
# Public URL of this API (used to build image links for local storage). Leave empty to derive it from each request.
SERVER_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave EMAIL_HOST empty in development: emails (verification / reset links) are printed to the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Digital Hostel <no-reply@example.com>"

# Used only by `npm run seed`. Passwords must satisfy the password policy
# (min 8 chars, upper + lower case, number). Users with an empty email/password are skipped.
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
